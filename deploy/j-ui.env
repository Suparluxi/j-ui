JUI_LISTEN_ADDRESS=0.0.0.0:8080
JUI_TLS_CERTIFICATE_PATH=
JUI_TLS_KEY_PATH=
JUI_DATA_DIR=/var/lib/j-ui
JUI_CONFIG_DIR=/etc/j-ui
JUI_SINGBOX_BINARY=/usr/local/lib/j-ui/sing-box
JUI_VPNGATE_MAX_EXITS=5
JUI_NODE_START_PORT=8881
JUI_LANGUAGE=zh-CN
# Optional ISO 3166-1 alpha-2 code used for the dashboard flag, for example JP.
JUI_COUNTRY_CODE=
