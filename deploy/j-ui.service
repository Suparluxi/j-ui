[Unit]
Description=J-UI self-hosted node manager
After=network-online.target nftables.service firewalld.service ufw.service j-ui-sing-box.service
Wants=network-online.target j-ui-sing-box.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/j-ui/j-ui.env
Environment=JUI_SERVICE_MODE=server
ExecStartPre=/usr/local/lib/j-ui/update.sh --ensure-residential-runtime
ExecStart=/usr/local/bin/j-ui
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/etc/j-ui /var/lib/j-ui /etc/systemd/system -/etc/ufw -/etc/firewalld -/var/lib/firewalld
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
SystemCallArchitectures=native
LimitNOFILE=65536
TasksMax=256
UMask=0077

[Install]
WantedBy=multi-user.target
